cc_defaults {
    name: "libudfpshandler_moto_defaults",
    shared_libs: [
        "libbase",
        "libutils",
    ],
    header_libs: [
        "generated_kernel_headers",
        "libudfpshandler_headers",
    ],
    vendor: true,
}

cc_library {
    name: "libudfpshandler_moto",
    defaults: ["libudfpshandler_moto_defaults"],
    srcs: ["UdfpsHandlerMoto.cpp"],
    shared_libs: [
        "libhidlbase",
        "com.motorola.hardware.biometric.fingerprint@1.0",
    ],
}

cc_library {
    name: "libudfpshandler_moto_hbm",
    defaults: ["libudfpshandler_moto_defaults"],
    srcs: ["UdfpsHandlerMotoHbm.cpp"],
}
